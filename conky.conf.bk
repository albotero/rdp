conky.config = {
    update_interval = 1,

    own_window = false,
    own_window_type = 'normal',

    alignment = 'top_right',

    gap_x = 30,
    gap_y = 30,

    use_xft = true,
    font = 'DejaVu Sans Mono:size=11',

    default_color = 'white',

    draw_borders = false,
    draw_outline = false,
    draw_shades = false,
};

